	"agent": {
		"general": {
			"disable": true
		},
		"scout": {
			"disable": true
		},
		"explore": {
			"disable": false
		}
	},
	"tools": {
		"wigolo_*": false
	},
	"mcp": {
		"wigolo": {
			"type": "local",
			"command": [
				"wigolo"
			],
			"enabled": true
		}
	},
	"plugin": [
		"@mohak34/opencode-notifier@0.2.8",
		"magic-compact@1.2.2",
		"@slkiser/opencode-quota@4.6.1"
	]
