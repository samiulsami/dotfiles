{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "aura"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "app.exit": "ctrl+c",
    "command.palette.show": "ctrl+o",
    "prompt.editor": "<leader>e",
    "theme.switch": "<leader>t",
    "session.sidebar.toggle": "<leader>b",
    "opencode.status": "<leader>s",
    "session.export": "none",
    "session.new": "<leader>n",
    "session.list": "<leader>l",
    "session.timeline": "<leader>g",
    "session.share": "none",
    "session.unshare": "none",
    "session.interrupt": "escape",
    "session.compact": "<leader>c",
    "model.list": "<leader>m",
    "model.cycle_recent": "f2",
    "model.cycle_recent_reverse": "shift+f2",
    "model.cycle_favorite": "ctrl+n",
    "model.cycle_favorite_reverse": "ctrl+p",
    "agent.list": "<leader>a",
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab",
    "session.page.up": "ctrl+e",
    "session.page.down": "ctrl+b",
    "session.half.page.up": "none",
    "session.half.page.down": "none",
    "session.first": "ctrl+g,home",
    "session.last": "ctrl+alt+g,end",
    "messages.copy": "<leader>y",
    "session.undo": "<leader>u",
    "session.redo": "<leader>r",
    "prompt.clear": "ctrl+c",
    "prompt.paste": "ctrl+v,ctrl+shift+v",
    "input.submit": "return",
    "input.newline": "shift+return",
    "prompt.history.previous": "up",
    "prompt.history.next": "down"
  },
  "scroll": {
    "speed": 2,
    "acceleration": true
  },
  "diffs": {
    "wrap": "none"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
